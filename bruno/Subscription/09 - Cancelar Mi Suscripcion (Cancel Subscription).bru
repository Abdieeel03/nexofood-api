meta {
  name: 09 - Cancelar Mi Suscripcion (Cancel Subscription)
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/subscriptions/me/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Cancela inmediatamente si es TRIAL/PENDING o marca cancelAtPeriodEnd=true manteniendo acceso hasta endDate si es ACTIVE pagada", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.status).to.be.oneOf(["CANCELED", "ACTIVE"]);
  });
}
