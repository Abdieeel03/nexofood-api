meta {
  name: 03 - Admin - Listar Todos los Planes (SUPERADMIN)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/plans
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna lista de todos los planes", function() {
    expect(res.getBody().data).to.be.an('array');
  });
}
