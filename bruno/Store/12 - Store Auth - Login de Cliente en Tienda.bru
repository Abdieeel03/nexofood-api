meta {
  name: 12 - Store Auth - Login de Cliente en Tienda
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/store/{{tenantSlug}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "lucia.cliente@nexofood.lat",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody().data;
    if (data && data.user && data.user.id) {
      bru.setEnvVar("customerId", data.user.id);
    }
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna perfil de cliente contextualizado al tenant", function() {
    const data = res.getBody().data;
    expect(data.accessToken).to.be.a('string');
    expect(data.customerProfile).to.be.an('object');
  });
}
