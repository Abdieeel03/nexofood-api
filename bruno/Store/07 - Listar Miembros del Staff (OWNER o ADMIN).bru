meta {
  name: 07 - Listar Miembros del Staff (OWNER o ADMIN)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/members
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna lista de miembros del equipo", function() {
    expect(res.getBody().data).to.be.an('array');
  });
}
