meta {
  name: 02 - Obtener Mi Restaurante (Get My Tenant)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/tenants/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody().data;
    if (data && data.id) {
      bru.setEnvVar("tenantId", data.id);
    }
    if (data && data.slug) {
      bru.setEnvVar("tenantSlug", data.slug);
    }
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna datos del restaurante del usuario", function() {
    const data = res.getBody().data;
    expect(data.id).to.be.a('string');
    expect(data.name).to.be.a('string');
  });
}
