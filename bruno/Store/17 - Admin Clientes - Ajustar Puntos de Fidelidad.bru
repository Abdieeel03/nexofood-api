meta {
  name: 17 - Admin Clientes - Ajustar Puntos de Fidelidad
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/api/v1/admin/tenants/{{tenantId}}/customers/{{customerId}}/points
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "adjustment": 50
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Puntos de fidelidad actualizados", function() {
    const data = res.getBody().data;
    expect(data.loyaltyPoints).to.be.at.least(50);
  });
}
