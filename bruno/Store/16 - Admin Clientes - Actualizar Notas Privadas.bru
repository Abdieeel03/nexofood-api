meta {
  name: 16 - Admin Clientes - Actualizar Notas Privadas
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/admin/tenants/{{tenantId}}/customers/{{customerId}}/notes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "notes": "Cliente frecuente, prefiere entrega sin timbre."
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Notas actualizadas correctamente", function() {
    const data = res.getBody().data;
    expect(data.notes).to.equal("Cliente frecuente, prefiere entrega sin timbre.");
  });
}
