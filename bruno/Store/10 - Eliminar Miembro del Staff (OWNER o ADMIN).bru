meta {
  name: 10 - Eliminar Miembro del Staff (OWNER o ADMIN)
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/members/{{memberId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Respuesta confirma desvinculación", function() {
    expect(res.getBody().success).to.be.true;
  });
}
