meta {
  name: 05 - Backoffice - Mapa de Repartidores Activos en Ruta (OWNER o ADMIN)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/tracking/active
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna lista de repartidores actualmente en ruta (EN_CAMINO)", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data).to.be.an('array');
  });
}

