meta {
  name: 02 - Contador de Notificaciones No Leidas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/notifications/unread-count
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna el contador de notificaciones no leídas", function() {
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data.unreadCount).to.be.a('number');
  });
}
