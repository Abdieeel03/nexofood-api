meta {
  name: 05 - Backoffice - Obtener Detalle de Orden (Miembro)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/orders/{{orderId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK (accesible por cualquier miembro del staff)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna el detalle completo de la orden con sus ítems e impuestos", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.id).to.equal(bru.getEnvVar("orderId"));
    expect(data.items).to.be.an('array');
  });
}
