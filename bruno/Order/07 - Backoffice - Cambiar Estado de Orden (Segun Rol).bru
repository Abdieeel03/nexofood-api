meta {
  name: 07 - Backoffice - Cambiar Estado de Orden (Segun Rol)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/orders/{{orderId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "EN_PREPARACION"
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Actualiza el estado de la orden según la máquina de estados", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.status).to.equal("EN_PREPARACION");
  });
}
