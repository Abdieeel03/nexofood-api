meta {
  name: 06 - Items - Eliminar Insumo (OWNER o ADMIN)
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/inventory/items/{{inventoryItemId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Elimina el insumo sin stock ni recetas", function() {
    expect(res.getBody().success).to.be.true;
  });
}

