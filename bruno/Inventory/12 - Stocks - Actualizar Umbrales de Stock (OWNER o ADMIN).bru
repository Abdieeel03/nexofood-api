meta {
  name: 12 - Stocks - Actualizar Umbrales de Stock (OWNER o ADMIN)
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/inventory/stocks/{{stockId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "minimumStock": 8.000,
    "maximumStock": 60.000,
    "location": "Cámara Fría B-2",
    "isActive": true
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Actualiza umbrales mínimo/máximo y ubicación del stock", function() {
    expect(res.getBody().success).to.be.true;
  });
}

