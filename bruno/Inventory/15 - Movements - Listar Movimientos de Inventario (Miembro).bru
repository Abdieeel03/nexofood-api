meta {
  name: 15 - Movements - Listar Movimientos de Inventario (Miembro)
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/inventory/movements?page=0&size=20
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 20
  ~movementType: ENTRY
  ~reason: PURCHASE
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna lista paginada de movimientos de inventario", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.content).to.be.an('array');
  });
}

