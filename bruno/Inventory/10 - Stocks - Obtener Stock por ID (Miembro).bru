meta {
  name: 10 - Stocks - Obtener Stock por ID (Miembro)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/inventory/stocks/{{stockId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna el detalle del registro de existencias", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.id).to.equal(bru.getEnvVar("stockId"));
  });
}

