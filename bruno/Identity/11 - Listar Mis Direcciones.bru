meta {
  name: 11 - Listar Mis Direcciones
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/users/me/addresses
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna lista de direcciones del usuario", function() {
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data).to.be.an('array');
  });
}
