meta {
  name: 13 - Eliminar Direccion
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/api/v1/users/me/addresses/{{addressId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Dirección eliminada exitosamente", function() {
    expect(res.getBody().success).to.be.true;
  });
}
