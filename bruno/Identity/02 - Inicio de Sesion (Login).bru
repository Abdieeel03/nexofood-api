meta {
  name: 02 - Inicio de Sesion (Login)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@nexofood.lat",
    "password": "Password123!"
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Respuesta contiene success true", function() {
    expect(res.getBody().success).to.be.true;
  });

  test("Contiene tokens válidos", function() {
    const data = res.getBody().data;
    expect(data.accessToken).to.be.a('string');
    expect(data.refreshToken).to.be.a('string');
    expect(data.user.email).to.equal('admin@nexofood.lat');
  });
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody().data;
    if (data && data.accessToken) {
      bru.setEnvVar("accessToken", data.accessToken);
    }
    if (data && data.refreshToken) {
      bru.setEnvVar("refreshToken", data.refreshToken);
    }
  }
}
