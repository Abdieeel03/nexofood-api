meta {
  name: 17 - Admin - Cambiar Estado Usuario (SUPERADMIN)
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "isActive": true
  }
}

tests {
  test("Código de estado es 200 OK (SUPERADMIN)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Estado del usuario actualizado", function() {
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data.isActive).to.be.true;
  });
}
