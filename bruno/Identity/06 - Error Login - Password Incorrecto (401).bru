meta {
  name: 06 - Error Login - Password Incorrecto (401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@nexofood.lat",
    "password": "PasswordEquivocada!"
  }
}

tests {
  test("Código de estado es 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Mensaje indica credenciales incorrectas", function() {
    const body = res.getBody();
    expect(body.status).to.equal(401);
    expect(body.message).to.equal("Las credenciales proporcionadas son incorrectas");
  });
}
