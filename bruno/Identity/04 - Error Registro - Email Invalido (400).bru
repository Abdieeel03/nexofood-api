meta {
  name: 04 - Error Registro - Email Invalido (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "correo-no-valido",
    "password": "Password123!",
    "fullName": "Prueba Invalida",
    "phone": "+51999888777"
  }
}

tests {
  test("Código de estado es 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Mensaje describe error de validación", function() {
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.message).to.include("email");
  });
}
