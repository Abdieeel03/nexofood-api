meta {
  name: 10 - Categories - Reordenar Categoria (OWNER o ADMIN)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/categories/{{categoryId}}/sort-order
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sortOrder": 2
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Actualiza el sortOrder de la categoría", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.sortOrder).to.equal(2);
  });
}
