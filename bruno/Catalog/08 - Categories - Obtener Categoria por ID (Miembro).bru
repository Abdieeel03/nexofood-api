meta {
  name: 08 - Categories - Obtener Categoria por ID (Miembro)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/categories/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK (accesible por cualquier miembro del staff)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna el detalle de la categoría solicitada", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.id).to.equal(bru.getEnvVar("categoryId"));
  });
}
