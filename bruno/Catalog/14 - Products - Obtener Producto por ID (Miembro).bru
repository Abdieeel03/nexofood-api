meta {
  name: 14 - Products - Obtener Producto por ID (Miembro)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/products/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK (accesible por cualquier miembro del staff)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna el detalle del producto con sus reglas de precio", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.id).to.equal(bru.getEnvVar("productId"));
    expect(data.prices).to.be.an('array');
  });
}
