meta {
  name: 25 - Products - Actualizar Stock (OWNER o ADMIN)
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/products/{{productId}}/stock
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "stock": 50
  }
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Actualiza el stock del producto correctamente", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.stock).to.equal(50);
  });
}
