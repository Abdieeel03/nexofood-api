meta {
  name: 23 - Categories - Eliminar Categoria (OWNER o ADMIN)
  type: http
  seq: 23
}

delete {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/categories/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Elimina la categoría exitosamente", function() {
    expect(res.getBody().success).to.be.true;
  });
}

