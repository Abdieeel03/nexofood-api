meta {
  name: 24 - Prices - Obtener Regla de Precio por ID (Miembro)
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/products/{{productId}}/prices/{{priceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna el detalle de la regla de precio", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.id).to.equal(bru.getEnvVar("priceId"));
  });
}

