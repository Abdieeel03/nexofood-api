meta {
  name: 09 - Webhook - Notificacion de Suscripcion Preapproval (Firma HMAC)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/webhooks/mercadopago?data.id={{mpPreapprovalId}}&type=subscription_preapproval
  body: json
  auth: none
}

params:query {
  data.id: {{mpPreapprovalId}}
  type: subscription_preapproval
}

headers {
  Content-Type: application/json
  x-request-id: req-sub-webhook-001
  x-signature: ts=1731100000,v1=reemplazar_con_hmac_sha256_del_manifiesto
}

body:json {
  {
    "id": "evt-sub-001",
    "live_mode": false,
    "type": "subscription_preapproval",
    "date_created": "2026-11-08T18:35:00Z",
    "user_id": 112233,
    "api_version": "v1",
    "action": "updated",
    "data": {
      "id": "{{mpPreapprovalId}}"
    }
  }
}

tests {
  test("Responde 200 OK si la firma HMAC es válida o 401 si es inválida", function() {
    expect(res.getStatus()).to.be.oneOf([200, 401]);
  });
}
