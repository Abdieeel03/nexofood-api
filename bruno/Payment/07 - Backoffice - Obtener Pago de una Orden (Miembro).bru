meta {
  name: 07 - Backoffice - Obtener Pago de una Orden (Miembro)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/tenants/{{tenantId}}/orders/{{orderId}}/payment
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Código de estado es 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna el detalle del pago asociado al pedido", function() {
    const data = res.getBody().data;
    expect(res.getBody().success).to.be.true;
    expect(data.orderId).to.equal(bru.getEnvVar("orderId"));
    expect(data.status).to.be.a('string');
  });
}
