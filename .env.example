# ==========================================
# NexoFood API - Variables de Entorno (.env)
# ==========================================

# Perfil activo de Spring Boot (dev | prod)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Base de Datos PostgreSQL + PostGIS
DB_URL=jdbc:postgresql://localhost:5432/nexofood_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Clave maestra AES-256-GCM en Base64 (exactamente 32 bytes decodificados)
# Ejemplo para generar una: openssl rand -base64 32
CRYPTO_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Secretos JWT (mínimo 256 bits / 32 caracteres)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_SECRET_REFRESH=70337336763979244226452948404D635166546A576E5A723475377821412544
JWT_EXPIRATION_TIME=900000
JWT_REFRESH_EXPIRATION=604800000

# Configuración CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,Accept,Origin
CORS_EXPOSED_HEADERS=Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600
