# ==========================================
# NexoFood API - Variables de Entorno (.env)
# ==========================================

# Perfil activo de Spring Boot (dev | prod)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Base de Datos PostgreSQL + PostGIS
DB_URL=jdbc:postgresql://localhost:5432/nexofood_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Clave maestra AES-256-GCM en Base64 (exactamente 32 bytes decodificados)
# Ejemplo para generar una: openssl rand -base64 32
CRYPTO_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Secretos JWT (mínimo 256 bits / 32 caracteres)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_SECRET_REFRESH=70337336763979244226452948404D635166546A576E5A723475377821412544
JWT_EXPIRATION_TIME=900000
JWT_REFRESH_EXPIRATION=604800000

# Configuración CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,Accept,Origin
CORS_EXPOSED_HEADERS=Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ==========================================
# Mercado Pago (Checkout Pro Orders API + Suscripciones + OAuth)
# ==========================================
# En dev permite usar Modo Credenciales de Prueba si falta MP_CLIENT_SECRET.
# En prod mercadopago.allow-test-mode se fuerza a false y MP_TEST_PAYER_EMAIL debe permanecer vacío.
MP_ALLOW_TEST_MODE=true
MP_AUTH_BASE_URL=https://auth.mercadopago.com.pe
MP_CLIENT_ID=tu_mp_client_id
MP_CLIENT_SECRET=tu_mp_client_secret
MP_PLATFORM_ACCESS_TOKEN=APP_USR-tu_access_token_de_plataforma
MP_PLATFORM_PUBLIC_KEY=APP_USR-tu_public_key_de_plataforma
MP_TEST_PAYER_EMAIL=test_user_comprador@testuser.com
MP_WEBHOOK_SECRET=tu_webhook_secret
# Ejemplo en producción:
# MP_OAUTH_REDIRECT_URI=https://api.nexofood-app.com/api/v1/mercadopago/oauth/callback
MP_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/mercadopago/oauth/callback
MP_OAUTH_STATE_SECRET=586E3272357538782F413F4428472B4B6250645367566B597033733676397924
MP_ORDER_EXPIRATION=PT30M
# Ejemplo en producción:
# FRONTEND_URL=https://nexofood-app.com
FRONTEND_URL=http://localhost:5173

# ==========================================
# Supabase Storage (Signed Upload URLs)
# ==========================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_tu_secret_key
